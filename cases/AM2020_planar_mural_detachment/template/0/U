FoamFile
{
    format ascii;
    class volVectorField;
    location "0";
    object U;
}
dimensions [0 1 -1 0 0 0 0];
internalField uniform (0.0075 0 0);
boundaryField
{
    inlet { type fixedValue; value uniform (0.0075 0 0); }
    outlet { type pressureInletOutletVelocity; value uniform (0.0075 0 0); }
    wall { type noSlip; }
    axis { type empty; }
    front { type wedge; }
    back { type wedge; }
}
