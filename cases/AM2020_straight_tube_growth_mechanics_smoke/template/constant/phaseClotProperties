FoamFile
{
    format ascii;
    class dictionary;
    location "constant";
    object phaseClotProperties;
}

clotMechanics yes;

rho [1 -3 0 0 0 0 0] 1050;
nu [0 2 -1 0 0 0 0] 3.3333333333e-6;
D [0 2 -1 0 0 0 0] 1e-10;

// Passed active-growth operating point, run 20260730-230425.
alpha [0 2 -1 0 0 0 0] 1e-6;
k0 [0 1 -1 0 0 0 0] 4.6e-5;
k1 [-1 2 1 0 0 0 0] 0;
mobility [0 4 -1 0 0 0 0] 0;
epsilonC [0 1 0 0 0 0 0] 6e-6;
gradFloor [0 -1 0 0 0 0 0] 1e-12;
nPhaseCorrectors 2;

shearEnhancementModel thresholdSaturating;
gammaLow 3000;
gammaHigh 8000;
enhancementMax 20;

// Frozen mechanics operating point.
G 1000;
poissonRatio 0.12;
permeabilityModel kozenyCarman;
k0p 3.5e-14;
phi0 0.5;
Gc 1e6;
ell 3e-6;
etaRes 1e-6;
DgDetach 0.95;
nSkeletonCorrectors 20;
skeletonFixedPointTolerance 1e-7;
nStaggeredCorrectors 5;

stronglyCoupledFSI yes;
fsiTolerance 5e-5;
nFSICorrectors 60;
fsiAitken no;
fsiRelaxation 0.5;
fsiSweepTrace yes;
fsiNormProbeFraction 0.5;

etaP [0 0 1 0 0 0 0] 1e-5;
penaltyExponent 1;
qFloor [0 0 0 0 0 0 0] 1e-6;

// S25 (design 2026-10-10-S25 sections 2F and 12 item 7): timeScale = S_t = t_sim/t_phys. The solver
// refuses a dictionary without it (no default): its release and viscosity times are physical
// seconds. 1.0 is the unscaled series; a scaled child states it through the generator
// (mainCaseControls.json time_scale).
timeScale 1.0;
